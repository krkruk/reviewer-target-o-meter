# reviewer-target-o-meter — example environment
# Copy to `.env` and fill in real values. `.env` is gitignored; this file is committed.

# ──────────────────────────────────────────────────────────────────────
# LLM provider (REQUIRED)
# ──────────────────────────────────────────────────────────────────────
# OpenRouter API key. Read at runtime only — never hardcode, never echo
# into posted output (leakage guardrail, prd.md FR-003/§Guardrails).
OPENROUTER_API_KEY=

# ──────────────────────────────────────────────────────────────────────
# Model selection (OPTIONAL — sensible default shown)
# ──────────────────────────────────────────────────────────────────────
# OpenRouter model slug. Override to swap the analysis model without code
# changes. The default is a paid DeepSeek slug that honors structured output
# (json_schema + strict) and gives stable CI signal on large diffs.
MODEL=deepseek/deepseek-v4-flash-0731

# OpenRouter OpenAI-compatible endpoint. Override only to point at another
# OpenAI-compatible base URL (self-hosted gateway, local server, etc.).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ──────────────────────────────────────────────────────────────────────
# Diff base discovery (OPTIONAL)
# ──────────────────────────────────────────────────────────────────────
# The base ref to diff HEAD against. Resolution order (first wins):
#   1. BASE_REF (set this explicitly to force a base)
#   2. GITHUB_BASE_REF (auto-provided by the runner on pull_request events)
#   3. heuristic: origin/main → main → origin/master → master
# Leave unset to use the heuristic chain.
#BASE_REF=

# ──────────────────────────────────────────────────────────────────────
# GitHub PR posting (OPTIONAL — only when posting findings to a PR)
# ──────────────────────────────────────────────────────────────────────
# Mode switching is env-driven (no --github flag): the tool posts a Markdown
# PR comment ONLY when PR_NUMBER + GITHUB_TOKEN + GITHUB_REPOSITORY are ALL
# present; otherwise it emits the FindingsReport JSON to stdout (the default).
# Reading source and computing the diff are local operations and need NO token.
#
# In GitHub Actions, map these from contexts/secrets in the workflow's `env:`:
#   PR_NUMBER:           ${{ github.event.pull_request.number }}
#   GITHUB_TOKEN:        ${{ secrets.GITHUB_TOKEN }}   (auto-provided by the runner)
#   GITHUB_REPOSITORY:   auto-provided (owner/repo)    — do NOT set manually in GHA
#   GITHUB_API_URL:      auto-provided                 — do NOT set manually in GHA
#   GITHUB_BASE_REF:     auto-provided on pull_request — do NOT set manually in GHA
# Locally, set PR_NUMBER + GITHUB_TOKEN + GITHUB_REPOSITORY explicitly to post.
# A non-integer PR_NUMBER disables posting (WARNING on stderr) rather than crashing.
# Posting failures degrade to stdout JSON + a WARNING; exit stays advisory (FR-008).
#PR_NUMBER=
#GITHUB_TOKEN=
#GITHUB_REPOSITORY=
#GITHUB_API_URL=https://api.github.com

# ──────────────────────────────────────────────────────────────────────
# Stderr verbosity (OPTIONAL — sensible default shown)
# ──────────────────────────────────────────────────────────────────────
# Governs the INFO step trace on stderr only (review start/mode, diff/context/
# plan loaded, each graph node, review-complete counts, post attempt/result).
# Levels: DEBUG / INFO / WARNING / ERROR; default INFO. The Markdown preview of
# the report is ALWAYS shown (it is the payload, not a log line) — set WARNING
# to silence the trace and keep just the preview, or DEBUG for everything.
# stdout is never affected: it stays the machine-readable FindingsReport JSON.
LOG_LEVEL=INFO
